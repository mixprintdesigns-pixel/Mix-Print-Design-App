// MixPrint database schema.
// Money is stored as integer minor units (paisa for PKR) to avoid floating point errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts & authentication ────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique // always stored lower-cased
  name             String
  phone            String? // E.164, e.g. +923001234567 (needed for JazzCash / Easypaisa)
  passwordHash     String
  role             Role      @default(CUSTOMER)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime? // set when the mobile number is confirmed by SMS code
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  affiliateSignups AffiliateSignup[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]
  designRequests   DesignRequest[]
  messages         Message[]
  files            FileAsset[]
  affiliate        Affiliate?
  statusEvents     OrderStatusEvent[]
  proofsCreated    Proof[]            @relation("ProofCreatedBy")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // SHA-256 of the cookie token; the raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Office"
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

// One category tree shared by the Services and Products pages:
// Main Service → Category → Sub-category → … (unlimited nesting). Products belong to one category.
model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String // unique among siblings; URL segment, e.g. /services/board-maker/3d-sign-board
  description    String? // short summary for cards and default meta description
  content        String? // page description (100–200 words), editable in admin
  imageUrl       String?
  imageKey       String? // storage key of an uploaded image
  imageAlt       String?
  sortOrder      Int        @default(0)
  isVisible      Boolean    @default(true)
  priceFromMinor Int? // "from" price set by the owner; empty shows "Get Quote"
  priceUnit      String? // e.g. "per sq. ft"
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
}

enum ProductStatus {
  DRAFT // being set up, hidden from customers
  PUBLISHED // visible in the store
  ARCHIVED // retired, hidden, kept for order history
}

model Product {
  id                     String           @id @default(cuid())
  sku                    String           @unique // unique product identifier, e.g. BC-STD-001
  name                   String
  slug                   String           @unique
  summary                String? // short description
  description            String // full description
  categoryId             String
  category               Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  basePriceMinor         Int // per-unit price when no quantity tier applies
  minQuantity            Int              @default(1)
  quantityStep           Int              @default(1)
  turnaroundDays         Int              @default(3) // estimated production time, working days
  status                 ProductStatus    @default(DRAFT)
  isAvailable            Boolean          @default(true) // can be ordered right now
  isFeatured             Boolean          @default(false)
  allowsDesignService    Boolean          @default(true)
  seoTitle               String?
  seoDescription         String?
  affiliateCommissionBps Int? // overrides the affiliate program default; 1000 = 10%
  serviceCategoryId      String? // where the product appears on the Services page
  serviceCategory        ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  serviceSubtypeId       String?
  serviceSubtype         ServiceSubtype?  @relation(fields: [serviceSubtypeId], references: [id], onDelete: SetNull)
  serviceQualityId       String?
  serviceQuality         ServiceQuality?  @relation(fields: [serviceQualityId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  images         ProductImage[]
  options        ProductOption[]
  priceTiers     PriceTier[]
  bulkDiscounts  BulkDiscount[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  designRequests DesignRequest[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  storageKey String? // set for uploaded files so they can be deleted from storage
  alt        String
  sortOrder  Int     @default(0) // lowest sortOrder is the main image

  @@index([productId, sortOrder])
}

// Volume pricing: the highest tier whose minQuantity <= ordered quantity applies.
model PriceTier {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity    Int
  unitPriceMinor Int

  @@unique([productId, minQuantity])
}

// Bulk discount: the highest tier whose minQuantity <= quantity takes percentBps off the line.
model BulkDiscount {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  percentBps  Int // 500 = 5% off

  @@unique([productId, minQuantity])
}

enum OptionKind {
  SIZE
  MATERIAL
  FINISHING
  OTHER
}

enum OptionPricing {
  PER_UNIT // priceDeltaMinor is added to every unit
  PER_ORDER // priceDeltaMinor is charged once per cart line (setup fees, plates, die cutting)
}

// Configurable attributes such as Size, Paper Stock, Finish, Sides.
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  kind      OptionKind           @default(OTHER)
  sortOrder Int                  @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label           String
  priceDeltaMinor Int           @default(0)
  pricing         OptionPricing @default(PER_UNIT)
  sortOrder       Int           @default(0)

  @@unique([optionId, label])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique // SHA-256 of the guest cart cookie
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          CartItem[]
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  optionValueIds String[] // selected ProductOptionValue ids
  configKey      String // sorted option value ids joined; identifies identical configurations
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([cartId, productId, configKey])
}

// ─── Orders & tracking ────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW // e.g. bank transfer awaiting manual confirmation
  CONFIRMED
  IN_DESIGN
  AWAITING_PROOF_APPROVAL
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique // human friendly, e.g. MP-260001
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @default("PKR")
  subtotalMinor   Int
  shippingMinor   Int         @default(0)
  discountMinor   Int         @default(0)
  totalMinor      Int
  shippingAddress Json // snapshot of the address at checkout
  customerNotes   String?
  courier         String? // TCS, Leopards, M&P, PostEx…
  trackingNumber  String?
  affiliateId     String?
  affiliate       Affiliate?  @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusEvents  OrderStatusEvent[]
  proofs        Proof[]
  conversation  Conversation?
  commission    AffiliateCommission?
  designRequest DesignRequest?

  @@index([userId, placedAt])
  @@index([status])
}

model OrderItem {
  id             String     @id @default(cuid())
  orderId        String
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String // snapshot
  optionsSummary Json // snapshot: [{ option: "Size", value: "A4" }]
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int
  artworkFileId  String?
  artworkFile    FileAsset? @relation(fields: [artworkFileId], references: [id], onDelete: SetNull)
  proofs         Proof[]
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ─── Payments (JazzCash / Easypaisa first) ────────────────────────────────────

enum PaymentProvider {
  JAZZCASH
  EASYPAISA
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentMethod {
  MOBILE_WALLET // JazzCash MWALLET / Easypaisa MA
  CARD // hosted card checkout via JazzCash or Easypaisa
  VOUCHER // JazzCash OTC / Easypaisa shop voucher
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  INITIATED
  PENDING // waiting on customer (wallet approval, OTC voucher payment)
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Payment {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider             PaymentProvider
  method               PaymentMethod
  status               PaymentStatus   @default(INITIATED)
  amountMinor          Int
  currency             String          @default("PKR")
  txnRef               String          @unique // our reference sent to the gateway (pp_TxnRefNo / orderRefNum)
  providerTxnId        String? // gateway's own transaction id
  providerResponseCode String?
  providerMessage      String?
  walletMobile         String? // payer mobile for wallet payments
  voucherExpiresAt     DateTime?
  requestPayload       Json? // signed request sent (secrets stripped)
  responsePayload      Json? // last callback / inquiry response
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

// ─── Files, design requests & proofs ─────────────────────────────────────────

enum FileKind {
  ARTWORK
  REFERENCE
  PROOF
  CHAT_ATTACHMENT
  PRODUCT_IMAGE
}

model FileAsset {
  id           String   @id @default(cuid())
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  kind         FileKind
  storageKey   String   @unique // path in local disk / S3 / R2
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  orderItems     OrderItem[]
  proofs         Proof[]
  messages       Message[]
  designRequests DesignRequestFile[]
}

enum DesignRequestStatus {
  SUBMITTED
  QUOTED
  IN_PROGRESS
  PROOF_SENT
  APPROVED
  CANCELLED
}

model DesignRequest {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId     String?             @unique
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title       String
  brief       String
  budgetMinor Int?
  quoteMinor  Int?
  neededBy    DateTime?
  status      DesignRequestStatus @default(SUBMITTED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  files        DesignRequestFile[]
  proofs       Proof[]
  conversation Conversation?

  @@index([userId, createdAt])
}

model DesignRequestFile {
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  fileId          String
  file            FileAsset     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([designRequestId, fileId])
}

enum ProofStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SUPERSEDED
}

model Proof {
  id              String         @id @default(cuid())
  version         Int
  status          ProofStatus    @default(PENDING)
  fileId          String
  file            FileAsset      @relation(fields: [fileId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  designRequestId String?
  designRequest   DesignRequest? @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  staffNote       String?
  customerComment String?
  createdById     String?
  createdBy       User?          @relation("ProofCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  respondedAt     DateTime?

  @@index([orderId])
  @@index([designRequestId])
}

// ─── Chat (one conversation per order or design request) ─────────────────────

model Conversation {
  id              String         @id @default(cuid())
  orderId         String?        @unique
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designRequestId String?        @unique
  designRequest   DesignRequest? @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  messages        Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentId   String?
  attachment     FileAsset?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ─── Affiliate marketing ──────────────────────────────────────────────────────

enum AffiliateStatus {
  PENDING // applied, waiting for review
  APPROVED // can earn commission
  REJECTED
  SUSPENDED // links stop earning; existing balance is kept
}

enum PayoutMethod {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum CommissionStatus {
  PENDING // order placed; not yet delivered / inside the refund window
  APPROVED // earned, can be withdrawn
  PAID // included in a paid withdrawal
  REVERSED // order cancelled or refunded
}

enum WithdrawalStatus {
  REQUESTED
  PAID
  REJECTED
}

// Single row (id = 1) holding the program rules administrators can change.
model AffiliateSettings {
  id                 Int      @id @default(1)
  defaultRateBps     Int      @default(500) // 5% when neither product nor affiliate sets a rate
  cookieDays         Int      @default(30) // how long a referral click is remembered
  minWithdrawalMinor Int      @default(100000) // PKR 1,000
  holdDays           Int      @default(7) // days after delivery before commission is approved
  autoApprove        Boolean  @default(false) // approve new affiliates without review
  updatedAt          DateTime @updatedAt
}

model Affiliate {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String          @unique // used in referral links: /r/CODE
  status            AffiliateStatus @default(PENDING)
  commissionRateBps Int? // custom rate for this affiliate; null = program default
  payoutMethod      PayoutMethod?
  payoutAccount     String? // mobile wallet number or IBAN
  payoutAccountName String? // account title
  website           String? // website or social profile used for promotion
  promotionPlan     String? // how the applicant will promote MixPrint
  adminNote         String? // shown to the affiliate when rejected or suspended
  approvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
  withdrawals AffiliateWithdrawal[]
  orders      Order[]

  @@index([status])
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landingPath String
  referrer    String?
  ipHash      String? // keyed hash, never the raw IP
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@index([affiliateId, ipHash, createdAt])
}

model AffiliateCommission {
  id              String               @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId         String               @unique
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  baseAmountMinor Int // order item totals the commission was calculated on
  amountMinor     Int
  breakdown       Json // per item: product, base, rate
  status          CommissionStatus     @default(PENDING)
  note            String?
  withdrawalId    String?
  withdrawal      AffiliateWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  approvedAt      DateTime?
  reversedAt      DateTime?
  paidAt          DateTime?

  @@index([affiliateId, status])
}

model AffiliateWithdrawal {
  id             String                @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountMinor    Int
  method         PayoutMethod
  account        String
  accountName    String
  status         WithdrawalStatus      @default(REQUESTED)
  transactionRef String? // JazzCash / Easypaisa / bank reference entered by the admin
  adminNote      String?
  requestedAt    DateTime              @default(now())
  processedAt    DateTime?
  commissions    AffiliateCommission[]

  @@index([affiliateId, requestedAt])
  @@index([status])
}

// ─── Services (Service Category → Sub-type → Quality), admin-managed ─────────

model ServiceCategory {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  shortDescription String
  imageUrl         String?
  imageKey         String? // storage key of an uploaded image
  sortOrder        Int              @default(0)
  isVisible        Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  subtypes         ServiceSubtype[]
  products         Product[]
}

model ServiceSubtype {
  id               String           @id @default(cuid())
  categoryId       String
  category         ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  shortDescription String
  imageUrl         String?
  imageKey         String?
  sortOrder        Int              @default(0)
  isVisible        Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  qualities        ServiceQuality[]
  products         Product[]

  @@unique([categoryId, slug])
}

model ServiceQuality {
  id               String         @id @default(cuid())
  subtypeId        String
  subtype          ServiceSubtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  shortDescription String
  imageUrl         String?
  imageKey         String?
  sortOrder        Int            @default(0)
  isVisible        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  products         Product[]

  @@unique([subtypeId, slug])
}

// ─── Customer reviews (admin-managed testimonials) ───────────────────────────

model Review {
  id          String   @id @default(cuid())
  name        String
  location    String? // e.g. "Lahore"
  rating      Int // 1–5
  comment     String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// ─── Contact form submissions ────────────────────────────────────────────────

model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String? // e.g. "Quote: Board Maker / Backlit"
  service     String? // the service chosen on the contact form
  message     String
  ipHash      String?
  emailSentAt DateTime? // when the notification reached the business inbox
  emailError  String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// ─── Editable page content (About page, etc.) ────────────────────────────────

model SiteContent {
  key       String   @id // e.g. "about"
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── AI assistant knowledge base ─────────────────────────────────────────────

// Searchable copy of site content (products, services, pages), rebuilt when the content changes.
model KnowledgeChunk {
  id         String   @id @default(cuid())
  sourceType String // PRODUCT | SERVICE | PAGE
  sourceId   String
  title      String
  url        String
  content    String
  createdAt  DateTime @default(now())

  @@index([sourceType])
}

// Requests counted per key (e.g. "chat:<ip hash>") for basic rate limiting.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ─── Affiliate signup verification (email + SMS codes) ───────────────────────

// A pending affiliate signup. For new visitors no User exists until both codes are verified;
// for signed-in customers (userId set) the affiliate application waits for verification.
// Codes are stored only as keyed hashes.
model AffiliateSignup {
  id        String  @id @default(cuid())
  tokenHash String  @unique // SHA-256 of the httpOnly cookie that ties this signup to the browser
  userId    String? // existing account joining the program
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  email        String // lower-cased
  phone        String // E.164, +923xxxxxxxxx
  passwordHash String? // new accounts only

  // Affiliate application, submitted once verification succeeds
  payoutMethod      PayoutMethod
  payoutAccount     String
  payoutAccountName String
  website           String?
  promotionPlan     String

  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  emailAttempts      Int       @default(0)
  emailLastSentAt    DateTime?
  emailVerifiedAt    DateTime?

  phoneCodeHash      String?
  phoneCodeExpiresAt DateTime?
  phoneAttempts      Int       @default(0)
  phoneLastSentAt    DateTime?
  phoneVerifiedAt    DateTime?

  completedAt DateTime?
  expiresAt   DateTime // the whole pending signup is discarded after this
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([phone])
}
