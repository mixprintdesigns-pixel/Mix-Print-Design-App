# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://mixprint:mixprint_dev@127.0.0.1:5432/mixprint"
# Public site URL: used for canonical links, the sitemap and structured data. Set it to the live domain in production.
APP_URL="http://localhost:3000"

# First administrator: when this email registers and no admin exists yet, it becomes ADMIN.
# ADMIN_EMAILS="owner@example.com"

# Product image storage. Leave unset locally (files go to ./storage). On Vercel, create a Blob
# store (Storage → Blob) and connect it; Vercel then sets this automatically.
# BLOB_READ_WRITE_TOKEN=""

# ── Payments (stage 2) — sandbox credentials from the merchant portals ──
# JAZZCASH_MERCHANT_ID=""
# JAZZCASH_PASSWORD=""
# JAZZCASH_INTEGRITY_SALT=""
# JAZZCASH_BASE_URL="https://sandbox.jazzcash.com.pk"
# EASYPAISA_STORE_ID=""
# EASYPAISA_HASH_KEY=""
# EASYPAISA_USERNAME=""
# EASYPAISA_PASSWORD=""
# EASYPAISA_BASE_URL="https://easypaystg.easypaisa.com.pk"

# Secret used to hash affiliate click IPs (any long random string).
# AFFILIATE_IP_SECRET=""

# AI chat assistant (server-side only — never expose to the browser).
# Without a key the assistant still works in "site search" mode, linking to matching pages.
# ANTHROPIC_API_KEY=""
# CHAT_MODEL="claude-opus-5-5"

# Contact form emails to mixprintdesigns@gmail.com via Resend (https://resend.com).
# Without a key, messages are still saved in Admin → Contact messages.
# RESEND_API_KEY=""
# EMAIL_FROM="Mix Print Design <noreply@your-verified-domain.pk>"

# Affiliate signup verification: 6-digit codes by email (Resend, above) and SMS (Twilio).
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_MESSAGING_SERVICE_SID=""   # recommended; or set TWILIO_FROM to your Twilio number / approved sender ID
# TWILIO_FROM=""
# OTP_SECRET=""                     # long random string used to hash codes (falls back to APP_SECRET)
# OTP_DEV_OUTBOX="true"             # LOCAL TESTING ONLY: write codes to storage/dev-outbox.jsonl instead of sending
